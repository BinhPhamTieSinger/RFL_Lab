flowchart TD
  P["$$\begin{array}{c}\text{FedHEP+ screening, unchanged}\end{array}$$"]:::same
  G["$$\begin{array}{c}\text{each parent }g\text{ with at least 3 eligible members}\end{array}$$"]:::new
  GS["$$\begin{array}{c}\text{parent score} \cr \displaystyle c_g = \cos(\bar v_g, \tilde r)\end{array}$$"]:::new
  NULL["$$\begin{array}{c}\text{permutation test against 64 random groups of the same size} \cr \displaystyle z_g = \frac{c_g - \mathrm{med}(\mathrm{null})}{1.4826\,\mathrm{MAD}(\mathrm{null})}\end{array}$$"]:::new
  F{"$$\begin{array}{c}\displaystyle z_g \lt  -2\ ?\end{array}$$"}:::new
  V1["$$\begin{array}{c}\text{v1, Phase 4: stricter member cut this round} \cr \displaystyle z_i \lt  -1\end{array}$$"]:::new
  V2["$$\begin{array}{c}\text{v2, Phase 4b: alignment with the other members} \cr \displaystyle a_i = \cos\Big(u_i,\ \frac{1}{|g| - 1}\sum_{j \neq i} u_j\Big), \quad u_i = v_i - \tilde r\end{array}$$"]:::new
  E2["$$\begin{array}{c}\text{evidence update uses} \cr \displaystyle \min\big(z_i,\ -z_i^{\mathrm{align}}\big)\end{array}$$"]:::new
