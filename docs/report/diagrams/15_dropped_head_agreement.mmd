flowchart LR
  X["$$\begin{array}{c}\text{test input }x\text{ of client }i \cr \text{(prediction time only)}\end{array}$$"]:::same
  H["$$\begin{array}{c}\text{three heads on the shared trunk} \cr \text{root }z_r\text{, parent }z_p\text{, local }z_l\end{array}$$"]:::same
  E["$$\begin{array}{c}\text{FedHEP ensemble} \cr \displaystyle \hat y_{\mathrm{ens}} = \arg\max \sum_h \pi_h \tilde z_h\end{array}$$"]:::same
  Q{"$$\begin{array}{c}\text{personal heads agree} \cr \text{and disagree with the ensemble?} \cr \displaystyle \hat y_p = \hat y_l \ne \hat y_{\mathrm{ens}}\end{array}$$"}:::new
  P["$$\begin{array}{c}\text{predict with the personal heads} \cr \displaystyle z = \frac{z_l}{\sigma(z_l)} + \frac{z_p}{\sigma(z_p)}\end{array}$$"]:::new
  K["$$\begin{array}{c}\text{keep the ensemble}\end{array}$$"]:::same
  X --> H
  H --> E
  E --> Q
  Q -->|"$$\begin{array}{c}\text{yes}\end{array}$$"| P
  Q -->|"$$\begin{array}{c}\text{no}\end{array}$$"| K
  subgraph LEG[" "]
    direction LR
    l0["$$\begin{array}{c}\text{unchanged part of the model}\end{array}$$"]:::same
    l1["$$\begin{array}{c}\text{the tested component}\end{array}$$"]:::new
    l2["$$\begin{array}{c}\text{what it replaces or changes}\end{array}$$"]:::changed
  end
