flowchart LR
  UP["$$\begin{array}{c}\text{uploaded model }\theta_i\text{ of client }i\end{array}$$"]:::same
  PR["$$\begin{array}{c}\text{server runs }\theta_i\text{ on 200 probe images }x_1..x_P \cr \text{(FLTrust root set, no labels)}\end{array}$$"]:::new
  PL["$$\begin{array}{c}\text{probe logits} \cr \displaystyle p_i = \mathrm{vec}\big(z_r(x_1), \dots, z_r(x_P)\big) \cr \displaystyle s_i = \cos\big(p_i,\ \mathrm{med}_k\, p_k\big)\end{array}$$"]:::new
  HG["$$\begin{array}{c}\text{head gap} \cr \displaystyle s_i = \frac{1}{P}\sum_{x} \big[\mathrm{KL}(q_r \| q_l) + \mathrm{KL}(q_r \| q_p)\big]\end{array}$$"]:::new
  SIG["$$\begin{array}{c}\text{[1] screening signal (replaced)} \cr \text{root head, whole update}\end{array}$$"]:::changed
  Z["$$\begin{array}{c}\text{[2]-[4] robust z, two-sided, gap gate, patience, evidence} \cr \text{unchanged (R3)}\end{array}$$"]:::same
  UP --> PR
  PR --> PL
  PR --> HG
  PL -->|"$$\begin{array}{c}\text{or}\end{array}$$"| Z
  HG -->|"$$\begin{array}{c}\text{or}\end{array}$$"| Z
  SIG -.->|"$$\begin{array}{c}\text{instead of}\end{array}$$"| Z
  subgraph LEG[" "]
    direction LR
    l0["$$\begin{array}{c}\text{unchanged part of the model}\end{array}$$"]:::same
    l1["$$\begin{array}{c}\text{the tested component}\end{array}$$"]:::new
    l2["$$\begin{array}{c}\text{what it replaces or changes}\end{array}$$"]:::changed
  end
  style LEG fill:#fcfcfb,stroke:#e4e3df
