flowchart TD
  G["Global model: trunk + root head (+ parent heads, one per group)"]:::same -->|"client i gets trunk, root head,<br/>its group's parent head, its own local head"| C["Client i trains 5 local epochs<br/>loss = m_r CE_root + m_p CE_parent + m_l CE_local"]:::changed
  C --> UP["upload Δ_i (trunk, root head, parent head)"]:::same
  C --> LH["local head stays on the client"]:::new
  UP --> GA["Global: w ← w + FedAvg(Δ_i) over all clients"]:::same
  UP --> PA["Parent g: copy Global if its members agree<br/>(mean cosine > 0.5), else average members,<br/>with adaptive momentum"]:::new
  UP --> GR["Grouping: k-means on random projections<br/>of the updates; regroup when groups drift"]:::new
  GR --> PA
  GA --> G
  PA --> G
  C --> PR["Prediction: ensemble of the 3 heads,<br/>weights from confidence, loss and a learned prior"]:::new
  subgraph LEG["Legend"]
    direction LR
    l1["unchanged from the previous model"]:::same
    l2["new in this model"]:::new
    l3["changed in this model"]:::changed
    l4["removed in this model"]:::gone
  end
  classDef same fill:#f2f1ee,stroke:#9a9893,color:#0b0b0b
  classDef new fill:#d5f2e6,stroke:#1baf7a,stroke-width:2px,color:#0b0b0b
  classDef changed fill:#fdefc8,stroke:#eda100,stroke-width:2px,color:#0b0b0b
  classDef gone fill:#fde3d9,stroke:#eb6834,stroke-dasharray:4 3,color:#0b0b0b
  style LEG fill:#fcfcfb,stroke:#e4e3df
