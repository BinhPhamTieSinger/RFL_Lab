flowchart TD
  G["$$\begin{array}{c}\text{Global: trunk and root head }W_r \cr \text{parent heads }W_p^{(g)}\text{, one per group}\end{array}$$"]:::same
  C["$$\begin{array}{c}\text{Client }i\text{ trains }E = 5\text{ epochs on three losses} \cr \displaystyle \mathcal{L}_i = m_r\,\mathrm{CE}(z_r) + m_p\,\mathrm{CE}(\tilde z_p) + m_l\,\mathrm{CE}(\tilde z_l) \cr \text{weights }m_h\text{ from the label-skew score }r_i\end{array}$$"]:::changed
  LH["$$\begin{array}{c}\text{local head }W_l\text{ stays on the client}\end{array}$$"]:::new
  UP["$$\begin{array}{c}\text{upload }\Delta_i\end{array}$$"]:::same
  GA["$$\begin{array}{c}\text{Global: FedAvg over all clients} \cr \displaystyle w \leftarrow w + \sum_i \frac{n_i}{N}\,\Delta_i\end{array}$$"]:::same
  PA["$$\begin{array}{c}\text{Parent }g\text{ copies Global if its members agree} \cr \displaystyle \overline{\cos}(\Delta_i, \Delta_j)_{i,j \in g} \gt  0.5 \cr \text{otherwise it averages them; adaptive momentum}\end{array}$$"]:::new
  GR["$$\begin{array}{c}\text{Grouping: k-means on random projections of }\Delta_i \cr \text{regroup when groups drift}\end{array}$$"]:::new
  PR["$$\begin{array}{c}\text{Prediction: ensemble of the three heads} \cr \displaystyle p(y \mid x) = \mathrm{softmax}\Big(\sum_h \pi_h\, \tilde z_h(x)\Big)\end{array}$$"]:::new
  G -->|"$$\begin{array}{c}\text{trunk, }W_r\text{, own group's }W_p\text{, own }W_l\end{array}$$"| C
  C --> UP
  C --> LH
  UP --> GA
  UP --> PA
  UP --> GR
  GR --> PA
  GA --> G
  PA --> G
  C --> PR
