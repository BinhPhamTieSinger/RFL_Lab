flowchart TD
  C["$$\begin{array}{c}\text{clients train as in FedHEP} \cr \text{three heads, }E = 5\text{ epochs}\end{array}$$"]:::same
  UP["$$\begin{array}{c}\text{updates }\Delta_i\text{ of clients not isolated}\end{array}$$"]:::same
  SW["$$\begin{array}{c}\text{[1a] whole-update signal} \cr \displaystyle s_i^{\mathrm{w}} = \cos\big(\Delta_i^{\setminus \mathrm{BN}},\ \mathrm{med}_k\,\Delta_k^{\setminus \mathrm{BN}}\big)\end{array}$$"]:::new
  SC["$$\begin{array}{c}\text{[1b] critical-layer signal} \cr \displaystyle s_i^{\mathrm{c}} = \frac{1}{k}\sum_{\ell \in L^\star} \cos\big(\Delta_i^{(\ell)}, \tilde r^{(\ell)}\big) \cr L^\star\text{: the }k = 5\text{ most disputed layers}\end{array}$$"]:::new
  ZW["$$\begin{array}{c}\text{[2] robust z, two-sided} \cr \displaystyle z_i^{\mathrm{w}} \leftarrow -|z_i^{\mathrm{w}}|\end{array}$$"]:::changed
  ZC["$$\begin{array}{c}\text{[2] robust z, two-sided} \cr \displaystyle z_i^{\mathrm{c}} \leftarrow -|z_i^{\mathrm{c}}|\end{array}$$"]:::changed
  GW{"$$\begin{array}{c}\text{[3] gap gate} \cr \displaystyle g = \frac{\max_k \delta_k}{\mathrm{med}_k\,\delta_k} \ge 8\ ?\end{array}$$"}:::new
  GC{"$$\begin{array}{c}\text{[3] gap gate} \cr \displaystyle g = \frac{\max_k \delta_k}{\mathrm{med}_k\,\delta_k} \ge 8\ ?\end{array}$$"}:::new
  U["$$\begin{array}{c}\text{[1c] union of the two screens} \cr \displaystyle z_i = \min\big(z_i^{\mathrm{w}},\ z_i^{\mathrm{c}}\big)\end{array}$$"]:::new
  EX{"$$\begin{array}{c}\text{[4] }z_i \lt  -2.5 \cr \text{in 3 rounds in a row?}\end{array}$$"}:::changed
  OUT["$$\begin{array}{c}\text{left out this round}\end{array}$$"]:::same
  KEEP["$$\begin{array}{c}\text{kept clients}\end{array}$$"]:::same
  EV["$$\begin{array}{c}\text{evidence} \cr \displaystyle E_i \leftarrow 0.7\,E_i + 0.3\,z_i\end{array}$$"]:::same
  ISO{"$$\begin{array}{c}\text{[4] }E_i \lt  -1.5\text{ and }z_i \lt  -1.5 \cr \text{in 3 rounds in a row?}\end{array}$$"}:::changed
  PERM["$$\begin{array}{c}\text{isolated for good}\end{array}$$"]:::same
  RW["$$\begin{array}{c}\text{[6] rewind trunk and root head} \cr \displaystyle w \leftarrow M \odot w_{t^\star} + (1 - M) \odot w \cr t^\star\text{: before the first suspicious round}\end{array}$$"]:::new
  RG["$$\begin{array}{c}\text{regroup by weight similarity}\end{array}$$"]:::same
  PAR["$$\begin{array}{c}\text{parents: SCCF over kept members}\end{array}$$"]:::same
  L0["$$\begin{array}{c}\text{[5] Global step: L0, replaces SCCF} \cr \displaystyle \Delta = \mathrm{TM}_f\Big(\mathrm{NNM}_f\big(\mathrm{ARC}_f(\Delta_1, \dots, \Delta_n)\big)\Big)\end{array}$$"]:::new
  GLOB["$$\begin{array}{c}\text{Global model}\end{array}$$"]:::same
  INF["$$\begin{array}{c}\text{[7] optional, at prediction: depth-exit guard} \cr \displaystyle s(x) = 1 - \tfrac{1}{3}\sum_d e_d[\hat y] \gt  \tau_i \ \Rightarrow\ \text{exits vote}\end{array}$$"]:::new
  C --> UP
  UP --> SW
  UP --> SC
  SW --> ZW
  SC --> ZC
  ZW --> GW
  ZC --> GC
  GW -->|"$$\begin{array}{c}\text{no: }z \leftarrow \max(z, 0)\end{array}$$"| U
  GW -->|"$$\begin{array}{c}\text{yes}\end{array}$$"| U
  GC -->|"$$\begin{array}{c}\text{no: }z \leftarrow \max(z, 0)\end{array}$$"| U
  GC -->|"$$\begin{array}{c}\text{yes}\end{array}$$"| U
  U --> EX
  EX -->|"$$\begin{array}{c}\text{yes}\end{array}$$"| OUT
  EX -->|"$$\begin{array}{c}\text{no}\end{array}$$"| KEEP
  U --> EV
  EV --> ISO
  ISO -->|"$$\begin{array}{c}\text{yes}\end{array}$$"| PERM
  PERM --> RW
  KEEP --> RG
  RG --> PAR
  KEEP --> L0
  L0 --> GLOB
  RW --> GLOB
  GLOB --> INF
  subgraph LEG[" "]
    direction LR
    l0["$$\begin{array}{c}\text{unchanged}\end{array}$$"]:::same
    l1["$$\begin{array}{c}\text{new in this model}\end{array}$$"]:::new
    l2["$$\begin{array}{c}\text{changed in this model}\end{array}$$"]:::changed
    l3["$$\begin{array}{c}\text{removed in this model}\end{array}$$"]:::gone
  end
