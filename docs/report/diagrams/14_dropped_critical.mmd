flowchart LR
  UP["$$\begin{array}{c}\text{updates }\Delta_i\text{, shared layers }\ell \cr \text{(personal heads left out)}\end{array}$$"]:::same
  C["$$\begin{array}{c}\text{per layer: cosine to the layer's median} \cr \displaystyle c_{i\ell} = \cos\big(\Delta_i^{(\ell)},\ \mathrm{med}_k\,\Delta_k^{(\ell)}\big)\end{array}$$"]:::new
  D["$$\begin{array}{c}\text{the }k = 5\text{ most disputed layers} \cr \displaystyle L^\star = \mathrm{top}_5\ \mathrm{std}_i\, c_{i\ell}\end{array}$$"]:::new
  S["$$\begin{array}{c}\text{score} \cr \displaystyle s_i = \frac{1}{5}\sum_{\ell \in L^\star} c_{i\ell}\end{array}$$"]:::new
  Z["$$\begin{array}{c}\text{[2]-[4] unchanged (R3)}\end{array}$$"]:::same
  SIG["$$\begin{array}{c}\text{[1] screening signal (replaced)}\end{array}$$"]:::changed
